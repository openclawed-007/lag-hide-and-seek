rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      allow create: if request.resource.data.code == code
        && request.resource.data.created is int
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt <= request.time.toMillis() + 172800000;
      // Missing docs must be readable so join/create can check existence
      // instead of failing as "insufficient permissions".
      allow get: if resource == null
        || resource.data.expiresAt > request.time.toMillis();
      allow list: if false;
      allow update: if resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.code == resource.data.code
        && request.resource.data.created == resource.data.created
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.seekerToken == resource.data.seekerToken
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'seq', 'touched', 'meta', 'phase', 'players', 'pendingQuestion',
          'lastAnswer', 'activeCurses', 'timer', 'bannedQuestions',
          'disabledCategory', 'overflowingLeft', 'handCount', 'deckLeft',
          'maxHand', 'move', 'log',
          'seekers', 'hiders', 'seekerOnline', 'hiderOnline', 'seekerLocs',
          'events', 'ended'
        ]);
      allow delete: if resource.data.expiresAt <= request.time.toMillis()
        || resource.data.ended == true
        || !('players' in resource.data)
        || resource.data.players.size() == 0;
    }
  }
}
